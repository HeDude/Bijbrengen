---
// Generiek aanmeldformulier-blok: bedt een Google Formulier in op de eigen site.
// Elke gebruiksplek geeft zijn eigen formUrl (embed-URL met ?embedded=true) en
// thankYouPath (pad naar een eigen bedankpagina) mee.
//
// Let op: er is bewust GEEN automatische redirect-na-verzenden. Een eerdere versie
// telde iframe-'load'-events om verzenden te detecteren, maar Google's eigen
// cookie-consentscherm (vooral op mobiel) veroorzaakt zelf ook een extra load,
// waardoor de site soms doorstuurde alsof er verzonden was terwijl de bezoeker
// nog niets had ingevuld. Omdat de iframe een ander domein is, kunnen we vanuit
// deze pagina niet betrouwbaar zien wat er in het formulier gebeurt. In plaats
// daarvan bevestigt de bezoeker zelf met de knop hieronder — dat geeft geen
// foutieve conversies, wel een (kleine) onderrapportage van wie niet doorklikt.
// Optioneel: zet dezelfde tekst/link ook in de bevestigingsboodschap van het
// Google Formulier zelf (Instellingen > Presentatie > Bevestigingsbericht).
const {
  id = "aanmelden",
  eyebrow = "Aanmelden",
  title = "Aanmelden",
  description = "Vul het formulier hieronder in.",
  formUrl,
  thankYouPath,
  fallbackSubject = title
} = Astro.props;

// Sommige browsers (met name mobiele Safari, door blokkade van cookies van
// andere domeinen) kunnen het Google Formulier soms niet in de iframe laden.
// Bied daarom altijd ook een directe, niet-ingebedde link aan.
const standaloneUrl = formUrl ? formUrl.replace(/[?&]embedded=true/, "") : formUrl;
---

<section id={id} class="signup">
  <div class="signup__inner">
    <div class="signup__intro">
      <span class="page-cta__eyebrow signup__eyebrow">{eyebrow}</span>
      <h2>{title}</h2>
      <p>{description}</p>
    </div>

    <div class="signup__embed">
      <iframe
        src={formUrl}
        title={title}
        loading="lazy"
      >
        Laden…
      </iframe>
    </div>

    <p class="signup__openlink">
      Formulier laadt niet goed?
      <a href={standaloneUrl} target="_blank" rel="noopener noreferrer">Open het in een nieuw tabblad →</a>
    </p>

    <div class="signup__confirm">
      <p>Heb je het formulier verzonden?</p>
      <a href={thankYouPath} class="btn btn--primary">
        Ja, bevestig mijn aanmelding
      </a>
    </div>

    <p class="signup__fallback">
      Lukt het invullen niet? Mail dan direct naar
      <a href={`mailto:info@bijbrengen.nl?subject=${encodeURIComponent(fallbackSubject)}`}>info@bijbrengen.nl</a>.
    </p>
  </div>
</section>

<style>
  .signup {
    border-top: 1px solid #e5e7eb;
    background: #ffffff;
  }

  .signup__inner {
    max-width: 40rem;
    margin-inline: auto;
    padding: 5rem 1.25rem;
  }

  .signup__intro {
    margin-bottom: 2rem;
    text-align: center;
  }

  .signup__eyebrow {
    display: inline-flex;
    margin-bottom: 0.75rem;
  }

  .signup__intro h2 {
    margin: 0;
    color: #111827;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    line-height: 1.1;
  }

  .signup__intro p {
    margin: 1rem 0 0;
    color: #64748b;
    font-size: 1rem;
    line-height: 1.65;
  }

  .signup__embed {
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    background: #fafaf7;
    overflow: hidden;
  }

  .signup__embed iframe {
    display: block;
    width: 100%;
    min-height: 45rem;
    border: 0;
  }

  .signup__openlink {
    margin: 0.75rem 0 0;
    color: #64748b;
    font-size: 0.85rem;
    text-align: center;
  }

  .signup__openlink a {
    color: var(--color-bijbrengen-forest);
    font-weight: 600;
  }

  .signup__confirm {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    margin: 1.5rem 0 0;
    padding: 1rem 1.25rem;
    border: 1px solid rgb(22 101 52 / 0.2);
    border-radius: 0.75rem;
    background: #f0fdf4;
    text-align: center;
  }

  .signup__confirm p {
    margin: 0;
    color: #14532d;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .signup__fallback {
    margin: 1.25rem 0 0;
    color: #64748b;
    font-size: 0.85rem;
    text-align: center;
  }

  .signup__fallback a {
    color: var(--color-bijbrengen-forest);
    font-weight: 600;
  }
</style>
