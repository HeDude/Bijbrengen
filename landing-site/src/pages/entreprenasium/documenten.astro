---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/global.css";

const base = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Het Entreprenasium-archief is afgeschermd en niet publiek toegankelijk." />
    <meta name="viewport" content="width=device-width" />
    <title>Geen toegang - Entreprenasium archief</title>
    <script is:inline data-goatcounter="https://bijbrengen.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  </head>
  <body>
    <div class="page-shell">
      <Header />

      <main class="main-content">
        <section class="page-intro">
          <div class="page-intro__inner">
            <p class="eyebrow">Entreprenasium archief</p>
            <h1>Geen toegang</h1>
            <p>
              Het Entreprenasium-archief is afgeschermd. Downloads worden pas beschikbaar wanneer de toegangscontrole via de API is ingericht.
            </p>
            <div style="margin-top: 2rem;">
              <a href={`${base}entreprenasium/`} class="btn btn--secondary">Terug naar Entreprenasium</a>
            </div>
          </div>
        </section>
      </main>

      <Footer />
    </div>
  </body>
</html>
